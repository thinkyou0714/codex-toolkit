# .env.example — copy to .env (gitignored) and fill in. NEVER commit real values.
# These are the env vars the toolkit reads. All have sane defaults; set only
# what you need to override.

# --- Secrets (set in your shell/secret store, not committed) ---
# OPENAI_API_KEY=sk-...

# --- Core paths ---
# CODEX_HOME=$HOME/.codex
# CODEX_TOOLKIT_ROOT=/absolute/path/to/codex-toolkit
# CODEX_LOG_DIR=$CODEX_PROJECT_DIR/.codex/logs

# --- Models ---
# CODEX_REVIEW_MODEL=gpt-5-codex
# CODEX_FIX_MODEL=gpt-5-codex

# --- Cost circuit-breaker ---
# CODEX_COST_DAILY_USD=5.00
# CODEX_COST_PER_CALL_USD=1.00
# CODEX_REVIEW_EST_USD=0.20
# CODEX_FIX_EST_USD=0.40
# CODEX_COST_BREAKER_OFF=0

# --- Resilience ---
# CODEX_PROVIDER_CHAIN=openai,groq,openrouter,ollama

# --- Optional integrations (skipped gracefully when unset) ---
# CODEX_VAULT_DIR=$HOME/vault/research
# CODEX_SLACK_WEBHOOK_URL=
# CODEX_N8N_WEBHOOK_URL=
# HUB_BASE_URL=http://localhost:3000

# --- PSM ---
# CODEX_PSM_MAX_NOTES=50
