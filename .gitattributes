# Normalize text files to LF to prevent CRLF breakage on Windows checkouts.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.sh   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Binary files: exclude from text diffs and line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
